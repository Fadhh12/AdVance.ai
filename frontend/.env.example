# Copy to .env.local and fill in real values. Never commit .env.local with real secrets.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- NextAuth.js (Phase 1) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-string
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Dev-only: skip the login gate ---
# Uncomment while Postgres/Docker isn't running locally yet, so /register or /login
# can't succeed. Lets you browse the workspace pages without a session; anything that
# needs real data (media, jobs, projects, posts) still shows its empty state since there
# is no access token. Remove/leave unset once the backend + Postgres are reachable, and
# NEVER set this in a deployed environment — it disables the auth check entirely.
# SKIP_AUTH=true
