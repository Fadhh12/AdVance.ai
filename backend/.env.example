# Copy to .env and fill in real values. Never commit .env with real secrets.

# --- App ---
APP_NAME=adVance.AI
ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database (matches docker-compose.yml postgres service) ---
DATABASE_URL=postgresql+psycopg2://advance:advance_dev_password@localhost:5432/advance_ai

# --- Redis / Celery (matches docker-compose.yml redis service) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Object storage (matches docker-compose.yml minio service; swap for R2/S3 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=advance_minio
S3_SECRET_KEY=advance_minio_dev_password
S3_BUCKET_NAME=media-assets
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# --- Auth (Phase 1) ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- AI providers (Phase 3) — belum final dipilih, lihat docs/research/ai-providers-comparison.md.
# Kosongkan sampai provider dikonfirmasi user; app jatuh ke MockVideoProvider bila kosong.
AI_VIDEO_PROVIDER=mock
AI_VIDEO_PROVIDER_API_KEY=

# --- Social platform apps (Phase 6 — belum bisa dipakai, developer app belum approved) ---
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
