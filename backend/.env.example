# Copy to .env and fill in real values. Never commit .env with real secrets.

# --- App ---
APP_NAME=adVance.AI
ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database (matches docker-compose.yml postgres service) ---
DATABASE_URL=postgresql+psycopg2://advance:advance_dev_password@localhost:5432/advance_ai

# --- Redis / Celery (matches docker-compose.yml redis service) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Object storage (matches docker-compose.yml minio service; swap for R2/S3 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=advance_minio
S3_SECRET_KEY=advance_minio_dev_password
S3_BUCKET_NAME=media-assets
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# --- Auth (Phase 1) ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Owner account (Phase 6R) — akun dengan email ini otomatis dapat plan "Unlimited"
# saat register/login (bukan self-serve, lihat app/api/auth.py). Isi hanya di .env
# lokal (gitignored) dengan email kamu sendiri — jangan pernah commit email asli di sini.
OWNER_EMAIL=

# --- AI providers (Phase 3) — belum final dipilih, lihat docs/research/ai-providers-comparison.md.
# Kosongkan sampai provider dikonfirmasi user; app jatuh ke MockVideoProvider bila kosong.
AI_VIDEO_PROVIDER=mock
AI_VIDEO_PROVIDER_API_KEY=

# --- AI skills tambahan (Phase 6R — "AI Image"/"AI Audio") ---
AI_IMAGE_PROVIDER=mock
# Voice-over (Phase 6R-9): 'edge_tts' = provider gratis nyata (tanpa API key,
# Microsoft Edge neural voices), direkomendasikan sekarang. 'mock' = klip bisu.
AI_VOICEOVER_PROVIDER=mock

# --- LLM / agen chat (Phase 6R). Kosong/mock = MockLLMProvider (tidak butuh API key).
# Provider gratis direkomendasikan sekarang: Gemini — daftar API key gratis di
# https://aistudio.google.com/apikey, isi GEMINI_API_KEY, set AI_LLM_PROVIDER=gemini.
# Claude (berbayar) tetap tersedia sebagai upgrade path nanti begitu ada revenue —
# isi ANTHROPIC_API_KEY, set AI_LLM_PROVIDER=anthropic.
AI_LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- n8n orchestration (Phase 6R-10) — orkestrasi/notifikasi saja, BUKAN auto-posting
# ke IG/TikTok/YouTube (developer app belum approved, lihat CLAUDE.md). Kosong = mati.
# Isi dengan URL webhook n8n (mis. http://localhost:5678/webhook/adVance-pipeline)
# setelah workflow-nya dibuat di n8n (docker compose up -d, service "n8n").
N8N_WEBHOOK_URL=

# --- Social platform apps (Phase 6 — belum bisa dipakai, developer app belum approved) ---
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
